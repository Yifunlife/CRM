{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "yifun-crm",
  "account_id": "5a472d15dc37681abce4ab6e4eb152c3",
  "main": "./build/sites-worker.ts",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "triggers": {
    "crons": [
      "0 0 * * *",
      "0 21,22 * * *"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "yifun-crm-db",
      "database_id": "59e890b8-985a-4027-a205-50d8920509cb",
      "migrations_dir": "drizzle"
    },
    {
      "binding": "QUOTE_DB",
      "database_name": "yifunlife-erp-db",
      "database_id": "0c422bf7-378e-40df-a262-81dc0f73d4aa"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "yifun-crm-files"
    },
    {
      "binding": "QUOTE_BUCKET",
      "bucket_name": "yifunlife-erp-images"
    }
  ]
}
