{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "yifun-crm",
  "account_id": "5a472d15dc37681abce4ab6e4eb152c3",
  "main": "./build/sites-worker.ts",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "triggers": {"crons": ["*/5 * * * *"]},
  "d1_databases": [{
    "binding": "DB",
